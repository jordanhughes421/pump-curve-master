generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int         @id @default(autoincrement())
  name           String?
  email          String      @unique
  password       String
  firstName      String?
  lastName       String?
  companyName    String?
  profilePicture String?
  googleId       String?
  emailVerified  DateTime?
  image          String?
  role           String      @default("ENGINEER")
  accounts       Account[]
  createdPumps   PumpModel[]
  sessions       Session[]
}

model Account {
  id                 Int       @id @default(autoincrement())
  userId             Int
  providerType       String
  providerId         String
  providerAccountId  String
  refreshToken       String?
  accessToken        String?
  accessTokenExpires DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id])
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  expires      DateTime
  sessionToken String   @unique
  accessToken  String   @unique
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PumpModel {
  id           Int         @id @default(autoincrement())
  name         String
  type         String
  description  String?
  manufacturer String
  modelNumber  String
  maxFlow      Float
  maxHead      Float
  maxSpeed     Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId       Int
  bomItems     BOMItem[] // Renamed from bom to bomItems
  documents    Document[]
  curves       PumpCurve[]
  createdBy    User        @relation(fields: [userId], references: [id])
}

model PumpCurve {
  id          Int       @id @default(autoincrement())
  pumpModelId Int
  speed       Int
  points      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pumpModel   PumpModel @relation(fields: [pumpModelId], references: [id])

  // New fields for scaled curves
  isScaled        Boolean     @default(false)
  originalCurveId Int?
  originalCurve   PumpCurve?  @relation("ScaledCurves", fields: [originalCurveId], references: [id])
  scaledCurves    PumpCurve[] @relation("ScaledCurves")
  speedRatio      Float?
  diameterRatio   Float?
}

model Document {
  id          Int       @id @default(autoincrement())
  title       String
  fileUrl     String
  fileType    String
  pumpModelId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pumpModel   PumpModel @relation(fields: [pumpModelId], references: [id])
}

model BOMItem {
  id          Int        @id @default(autoincrement())
  pumpModelId Int? // Made optional
  partNumber  String
  description String
  quantity    Int
  unit        String
  supplier    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  pumpModel   PumpModel? @relation(fields: [pumpModelId], references: [id]) // Made optional

  // Self-referencing relation for parent-child
  parentId     Int?
  parent       BOMItem?         @relation("BOMItemChildren", fields: [parentId], references: [id])
  children     BOMItem[]        @relation("BOMItemChildren")
  customFields BOMCustomField[]
}

model BOMCustomField {
  id        Int      @id @default(autoincrement())
  name      String
  value     String
  bomItemId Int
  bomItem   BOMItem  @relation(fields: [bomItemId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
